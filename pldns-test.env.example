# Copy to pldns-test.env and fill in. Sourced by pldns-test.sh.

# Subscription where the initiative is assigned and test private endpoints are created
TEST_SUB="00000000-0000-0000-0000-000000000000"
# Shared subscription that holds the private DNS zones
SHARED_SUB="11111111-1111-1111-1111-111111111111"

LOCATION="uksouth"
LOCATION_SHORT="uks"
PREFIX="pldns" # lowercase letters only, <= 6 chars; used in resource names

# Resource groups
DNS_RG="rg-dns-${PREFIX}-test-${LOCATION_SHORT}"   # in SHARED_SUB; created if missing
TEST_RG="rg-${PREFIX}-test-${LOCATION_SHORT}"      # in TEST_SUB; deleted by 'down'

# Test network (zones are linked straight to this VNet for the test)
VNET_CIDR="10.250.0.0/24"
PE_SUBNET_CIDR="10.250.0.0/26"
VM_SUBNET_CIDR="10.250.0.64/27"

# Optional: also link the zones to an existing hub VNet (full resource ID)
HUB_VNET_ID=""

# Services to test. queue is created BEFORE the assignment to prove remediation.
# Available: blob file queue table vault acr sql cosmos
SERVICES="blob file queue table vault acr sql"

# Small VM used to prove name resolution from inside the VNet (nslookup via run-command)
ENABLE_VM="true"

# Effects for the test assignment
DNS_EFFECT="DeployIfNotExists" # DeployIfNotExists | AuditIfNotExists
DENY_EFFECT="Deny"             # Deny | Audit

# How long 'verify' and 'deny-test' wait for policy to act
WAIT_MINUTES=45

# 'down' deletes zones/DNS RG it created only when this is true
PURGE_DNS="false"
