tml=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#5b6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1508.0" y="660.5" width="150.7" height="15.8" as="geometry"/></mxCell><mxCell id="c200" value="→ A record in p0004ss" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#1f2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1508.0" y="676.5" width="122.9" height="15.8" as="geometry"/></mxCell><mxCell id="c201" value="No private DNS zones in this subscription (Deny policy)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#5b6472;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1160.0" y="706.5" width="312.1" height="15.8" as="geometry"/></mxCell><mxCell id="c202" value="Peered to hub · UDR 0.0.0.0/0 and shared-services ranges via firewall" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#5b6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1160.0" y="723.5" width="390.0" height="15.8" as="geometry"/></mxCell><mxCell id="c203" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#178a52;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1146.0" y="762.0" width="618.0" height="126.0" as="geometry"/></mxCell><mxCell id="c204" value="Same spoke pattern for the other subscriptions" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12;fontColor=#178a52;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160.0" y="770.8" width="298.6" height="18.0" as="geometry"/></mxCell><mxCell id="c205" value="n0001aks · n00br66 · p0005aks · devops-agents-prd · terraform-testing-prd · Design Subscription" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Consolas;fontSize=10.5;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1160.0" y="792.5" width="604.5" height="15.8" as="geometry"/></mxCell><mxCell id="c206" value="n0004ss (non-prod shared services): optional second resolver to test DNS changes." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#5b6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1160.0" y="816.5" width="456.8" height="15.8" as="geometry"/></mxCell><mxCell id="c207" value="It must not host its own privatelink zones (names are global, split brain)." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#5b6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1160.0" y="833.5" width="423.4" height="15.8" as="geometry"/></mxCell><mxCell id="c208" value="alz-identity · alz-state: platform spokes, same DNS settings." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#5b6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1160.0" y="856.5" width="345.5" height="15.8" as="geometry"/></mxCell><mxCell id="c209" style="html=1;rounded=1;edgeStyle=none;strokeColor=#1f2937;strokeWidth=4;endArrow=none;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="304" y="526" as="sourcePoint"/><mxPoint x="390" y="222" as="targetPoint"/><Array as="points"><mxPoint x="350" y="526"/><mxPoint x="350" y="222"/></Array></mxGeometry></mxCell><mxCell id="c210" value="ExpressRoute" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#1f2937;fontStyle=1;rotation=-90;" vertex="1" parent="1"><mxGeometry x="303.6" y="372.1" width="72.8" height="15.8" as="geometry"/></mxCell><mxCell id="c211" style="html=1;rounded=1;edgeStyle=none;strokeColor=#178a52;strokeWidth=3;endArrow=none;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="186" as="sourcePoint"/><mxPoint x="1130" y="186" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c212" value="VNet peering (hub ⇄ spokes)" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#178a52;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="901.9" y="166.4" width="156.3" height="15.8" as="geometry"/></mxCell><mxCell id="c213" style="html=1;rounded=1;edgeStyle=none;strokeColor=#6d3fd4;strokeWidth=3;endArrow=none;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="300" as="sourcePoint"/><mxPoint x="700" y="392" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c214" value="peering · use remote gateways" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#6d3fd4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="712.0" y="306.4" width="167.4" height="15.8" as="geometry"/></mxCell><mxCell id="c215" style="html=1;rounded=1;edgeStyle=none;strokeColor=#d1343c;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="304" y="300" as="sourcePoint"/><mxPoint x="402" y="530" as="targetPoint"/><Array as="points"><mxPoint x="328" y="300"/><mxPoint x="328" y="470"/></Array></mxGeometry></mxCell><mxCell id="c216" style="html=1;rounded=1;edgeStyle=none;strokeColor=#d1343c;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="176" as="sourcePoint"/><mxPoint x="170" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c217" value="1" style="ellipse;html=1;fillColor=#d1343c;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="159.0" y="172.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="c218" value="2" style="ellipse;html=1;fillColor=#d1343c;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="317.0" y="437.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="c219" style="html=1;rounded=1;edgeStyle=none;strokeColor=#d1343c;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1146" y="266" as="sourcePoint"/><mxPoint x="804" y="240" as="targetPoint"/><Array as="points"><mxPoint x="1000" y="266"/><mxPoint x="900" y="266"/></Array></mxGeometry></mxCell><mxCell id="c220" value="3" style="ellipse;html=1;fillColor=#d1343c;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="989.0" y="255.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="c221" style="html=1;rounded=1;edgeStyle=none;strokeColor=#d1343c;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=7 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="704" y="276" as="sourcePoint"/><mxPoint x="640" y="526" as="targetPoint"/><Array as="points"><mxPoint x="704" y="320"/><mxPoint x="690" y="470"/></Array></mxGeometry></mxCell><mxCell id="c222" style="html=1;rounded=1;edgeStyle=none;strokeColor=#d1343c;strokeWidth=2.2;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="616" as="sourcePoint"/><mxPoint x="560" y="642" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c223" value="4" style="ellipse;html=1;fillColor=#d1343c;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="569.0" y="619.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="c224" style="html=1;rounded=1;edgeStyle=none;strokeColor=#178a52;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=3 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1146" y="300" as="sourcePoint"/><mxPoint x="1086" y="700" as="targetPoint"/><Array as="points"><mxPoint x="1110" y="300"/><mxPoint x="1110" y="700"/></Array></mxGeometry></mxCell><mxCell id="c225" style="html=1;rounded=1;edgeStyle=none;strokeColor=#178a52;strokeWidth=1.6;endArrow=none;endFill=1;startArrow=none;dashed=1;dashPattern=3 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1146" y="512" as="sourcePoint"/><mxPoint x="1110" y="512" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c226" style="html=1;rounded=1;edgeStyle=none;strokeColor=#178a52;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=3 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1146" y="724" as="sourcePoint"/><mxPoint x="1086" y="726" as="targetPoint"/><Array as="points"><mxPoint x="1110" y="724"/><mxPoint x="1110" y="726"/></Array></mxGeometry></mxCell><mxCell id="c227" value="zone groups" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10;fontColor=#178a52;fontStyle=1;rotation=-90;" vertex="1" parent="1"><mxGeometry x="1071.8" y="872.5" width="64.3" height="15.0" as="geometry"/></mxCell><mxCell id="c228" style="html=1;rounded=1;edgeStyle=none;strokeColor=#d9730d;strokeWidth=1.8;endArrow=block;endFill=1;startArrow=none;dashed=1;dashPattern=5 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="404" y="586" as="sourcePoint"/><mxPoint x="304" y="470" as="targetPoint"/><Array as="points"><mxPoint x="320" y="586"/><mxPoint x="320" y="470"/></Array></mxGeometry></mxCell><mxCell id="c229" value="5" style="ellipse;html=1;fillColor=#d9730d;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="307.0" y="589.0" width="22.0" height="22.0" as="geometry"/></mxCell><mxCell id="c230" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20.0" y="920.0" width="1760.0" height="70.0" as="geometry"/></mxCell><mxCell id="c231" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/general/Management_Groups.svg;" vertex="1" parent="1"><mxGeometry x="34.0" y="935.0" width="36.0" height="36.0" as="geometry"/></mxCell><mxCell id="c232" value="Governance" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=13;fontColor=#1f2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80.0" y="935.7" width="74.9" height="19.5" as="geometry"/></mxCell><mxCell id="c233" value="landing-zones MG" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#5b6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="80.0" y="956.5" width="95.0" height="15.8" as="geometry"/></mxCell><mxCell id="c234" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="1"><mxGeometry x="250.0" y="935.0" width="34.0" height="34.0" as="geometry"/></mxCell><mxCell id="c235" value="DINE: private endpoint → zone group" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11.5;fontColor=#1f2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="292.0" y="937.4" width="219.3" height="17.2" as="geometry"/></mxCell><mxCell id="c236" value="pointing at the zones in p0004ss (per groupId)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#5b6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="292.0" y="956.5" width="262.0" height="15.8" as="geometry"/></mxCell><mxCell id="c237" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/management_governance/Policy.svg;" vertex="1" parent="1"><mxGeometry x="640.0" y="935.0" width="34.0" height="34.0" as="geometry"/></mxCell><mxCell id="c238" value="Deny privatelink.* zones" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11.5;fontColor=#1f2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="682.0" y="937.4" width="152.3" height="17.2" as="geometry"/></mxCell><mxCell id="c239" value="outside rg-iep-prd-pdnsz-shd (Audit first)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#5b6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="682.0" y="956.5" width="239.7" height="15.8" as="geometry"/></mxCell><mxCell id="c240" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="1010.0" y="935.0" width="34.0" height="34.0" as="geometry"/></mxCell><mxCell id="c241" value="Policy managed identity" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11.5;fontColor=#1f2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1052.0" y="937.4" width="146.2" height="17.2" as="geometry"/></mxCell><mxCell id="c242" value="Network Contributor (landing zones) + Private DNS Zone Contributor (zones RG)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=10.5;fontColor=#5b6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1052.0" y="956.5" width="434.5" height="15.8" as="geometry"/></mxCell><mxCell id="c243" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fdecee;strokeColor=#d1343c;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20.0" y="1004.0" width="860.0" height="172.0" as="geometry"/></mxCell><mxCell id="c244" value="How a name resolves (st1.blob.core.windows.net)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=13;fontColor=#d1343c;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="36.0" y="1013.7" width="329.8" height="19.5" as="geometry"/></mxCell><mxCell id="c245" value="① On-prem client asks enterprise DNS." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.0" y="1039.9" width="221.7" height="16.5" as="geometry"/></mxCell><mxCell id="c246" value="② Conditional forwarder sends blob.core.windows.net over ExpressRoute to the resolver inbound IP in p0004ss." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.0" y="1061.9" width="635.6" height="16.5" as="geometry"/></mxCell><mxCell id="c247" value="③ Spoke VMs/AKS ask the inbound IP directly (VNet DNS setting), routed through the hub firewall." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.0" y="1083.9" width="565.7" height="16.5" as="geometry"/></mxCell><mxCell id="c248" value="④ Resolver asks Azure DNS from the resolver VNet → public CNAME → linked privatelink zone answers the PE IP." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.0" y="1105.9" width="635.6" height="16.5" as="geometry"/></mxCell><mxCell id="c249" value="⑤ Names in corp.* go the other way: outbound endpoint + ruleset → on-prem DNS." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.0" y="1127.9" width="460.7" height="16.5" as="geometry"/></mxCell><mxCell id="c250" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#a15c00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900.0" y="1004.0" width="880.0" height="172.0" as="geometry"/></mxCell><mxCell id="c251" value="Design checks before build" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=13;fontColor=#a15c00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="916.0" y="1013.7" width="185.1" height="19.5" as="geometry"/></mxCell><mxCell id="c252" value="• Peering is not transitive: spokes need a firewall route to the resolver VNet, or a direct peering to it." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="916.0" y="1039.9" width="624.0" height="16.5" as="geometry"/></mxCell><mxCell id="c253" value="• On-prem reaches the inbound IP only if the resolver VNet uses the hub gateway (use remote gateways)." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="916.0" y="1061.9" width="600.7" height="16.5" as="geometry"/></mxCell><mxCell id="c254" value="• alz-connectivity exists: ALZ puts resolver + zones there. p0004ss is fine as long as it is the ONLY place." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="916.0" y="1083.9" width="635.6" height="16.5" as="geometry"/></mxCell><mxCell id="c255" value="• Prod and non-prod share these zones; non-prod pipelines never get rights on them, only the policy identity." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="916.0" y="1105.9" width="641.5" height="16.5" as="geometry"/></mxCell><mxCell id="c256" value="• Resolver is regional: add a second resolver (DR region) and list both inbound IPs everywhere." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="916.0" y="1127.9" width="559.9" height="16.5" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>