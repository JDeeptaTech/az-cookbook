1087.3" width="262.0" height="17.2" as="geometry"/></mxCell><mxCell id="c253" value="" style="image;aspect=fixed;html=1;points=[];image=img/lib/azure2/identity/Managed_Identities.svg;" vertex="1" parent="1"><mxGeometry x="1040.0" y="1066.0" width="34.0" height="34.0" as="geometry"/></mxCell><mxCell id="c254" value="Policy managed identity" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=13.2;fontColor=#1f2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1082.0" y="1065.5" width="166.9" height="19.8" as="geometry"/></mxCell><mxCell id="c255" value="Network Contributor (workload subs) + Private DNS Zone Contributor (zones RG)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=11.5;fontColor=#5b6472;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1082.0" y="1087.3" width="475.3" height="17.2" as="geometry"/></mxCell><mxCell id="c256" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fdecee;strokeColor=#d1343c;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20.0" y="1138.0" width="860.0" height="208.0" as="geometry"/></mxCell><mxCell id="c257" value="How a name resolves (st1.blob.core.windows.net)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=14.4;fontColor=#d1343c;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="36.0" y="1146.2" width="364.7" height="21.6" as="geometry"/></mxCell><mxCell id="c258" value="① On-prem client asks enterprise DNS." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12.1;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.0" y="1176.7" width="243.3" height="18.1" as="geometry"/></mxCell><mxCell id="c259" value="② Forwarder → ExpressRoute → Production gateway → peering → inbound IP." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12.1;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.0" y="1201.7" width="461.3" height="18.1" as="geometry"/></mxCell><mxCell id="c260" value="③ Spoke VMs/AKS ask the inbound IP directly over their peering." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12.1;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.0" y="1226.7" width="410.0" height="18.1" as="geometry"/></mxCell><mxCell id="c261" value="④ Resolver asks Azure DNS → CNAME → linked privatelink zone → PE IP." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12.1;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.0" y="1251.7" width="442.1" height="18.1" as="geometry"/></mxCell><mxCell id="c262" value="⑤ corp.* names go the other way: outbound endpoint + ruleset → on-prem DNS." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12.1;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="36.0" y="1276.7" width="487.0" height="18.1" as="geometry"/></mxCell><mxCell id="c263" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#a15c00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900.0" y="1138.0" width="880.0" height="208.0" as="geometry"/></mxCell><mxCell id="c264" value="Design checks before build" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=14.4;fontColor=#a15c00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="916.0" y="1146.2" width="204.4" height="21.6" as="geometry"/></mxCell><mxCell id="c265" value="• p0004ss reaches on-prem only via the Production gateway: &#x27;use remote gateways&#x27;." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12.1;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="916.0" y="1176.7" width="525.5" height="18.1" as="geometry"/></mxCell><mxCell id="c266" value="• Platform networking lives in a workload subscription: guard Production changes." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12.1;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="916.0" y="1201.7" width="525.5" height="18.1" as="geometry"/></mxCell><mxCell id="c267" value="• Peering is not transitive: each spoke peers with the resolver VNet (or an NVA)." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12.1;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="916.0" y="1226.7" width="525.5" height="18.1" as="geometry"/></mxCell><mxCell id="c268" value="• Non-prod reaching on-prem would also transit the Production gateway: decide." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12.1;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="916.0" y="1251.7" width="506.2" height="18.1" as="geometry"/></mxCell><mxCell id="c269" value="• Prod and non-prod share these zones: only the policy identity writes records." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12.1;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="916.0" y="1276.7" width="512.6" height="18.1" as="geometry"/></mxCell><mxCell id="c270" value="• Resolver is regional: add a DR-region resolver, list both inbound IPs everywhere." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Segoe UI;fontSize=12.1;fontColor=#1f2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="916.0" y="1301.7" width="538.3" height="18.1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>